# Export these values into your shell; never commit your real .env file.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
# Azure deployment name, not a model selector. This deployment must host gpt-6-luna.
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Leave unset for the default passwordless Entra flow; set only for the API-key fallback.
# AZURE_OPENAI_API_KEY=
